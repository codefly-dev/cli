    "/v1/releases/mcp": {
      "post": {
        "description": "Agent clients, through the authority's edge, as the person whose Work Context the request carries; every call is held to this route's policy.\n\nThe MCP Streamable HTTP transport, stateless: one JSON-RPC message per POST, answered with its result. Each tool runs as the viewer and reaches a module only through a child the authority issues through one of this solution's bindings. Any other method is refused.",
        "operationId": "Releases_Post_V1_Releases_Mcp",
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "type": "object"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "type": "object"
            }
          },
          "401": {
            "description": "The request carried no Work Context the authority checks for this solution.",
