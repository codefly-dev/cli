            }
          },
          "502": {
            "description": "A call this operation makes to a module failed.",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        },
        "summary": "Call the releases MCP server's tools as the viewer",
        "tags": [
          "releases"
        ],
        "x-codefly-authority-policy": {
          "requires": [
            {
              "resource_kind": "records.records",
              "actions": [
                "read"
              ]
            }
          ]
        }
      }
    },
