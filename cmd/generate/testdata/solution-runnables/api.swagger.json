    "/v1/releases/chat": {
      "get": {
        "description": "Any member of the organization\n\nThe intent and the installation the gateway stamped on the request",
        "operationId": "Releases_Get_V1_Releases_Chat",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/ChatBinding"
            }
          },
          "401": {
            "description": "The request carried no Work Context the authority checks for this solution.",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "502": {
            "description": "A call this operation makes to a module failed.",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        },
        "summary": "Name the Robin intent and installation the page binds its chat to",
        "tags": [
          "releases"
        ],
        "x-codefly-authority-policy": {
          "any_checked_caller": true
        }
      }
    },
    "/v1/releases/chat/install": {
      "post": {
        "description": "An organization administrator\n\nRobin asks the host to approve each intent version before writing it",
        "operationId": "Releases_Post_V1_Releases_Chat_Install",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/ChatInstallResult"
            }
          },
          "401": {
            "description": "The request carried no Work Context the authority checks for this solution.",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "502": {
            "description": "A call this operation makes to a module failed.",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        },
        "summary": "Import this solution's Robin intent into the installation",
        "tags": [
          "releases"
        ],
        "x-codefly-authority-policy": {
          "requires": [
            {
              "resource_kind": "robin.intents",
              "actions": [
                "import",
                "activate"
              ]
            }
          ]
        }
      }
    },
    "/v1/releases/history": {
      "get": {
        "description": "Any member who may read records\n\nNewest first; pins only when a component is named",
        "operationId": "Releases_Get_V1_Releases_History",
        "parameters": [
          {
            "in": "query",
            "name": "repo",
            "required": true,
            "type": "string"
          },
          {
            "in": "query",
            "name": "component",
            "required": false,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/History"
            }
          },
          "401": {
            "description": "The request carried no Work Context the authority checks for this solution.",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "502": {
            "description": "A call this operation makes to a module failed.",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        },
        "summary": "Read the recorded tags of one repository and the recorded pins of one component",
        "tags": [
          "releases"
        ],
        "x-codefly-authority-policy": {
          "requires": [
            {
              "resource_kind": "records.records",
              "actions": [
                "read"
              ]
            }
          ]
        },
        "x-codefly-operation": {
          "attempt_timeout": "30s",
          "audience": "releases",
          "backoff": "1s",
          "completion": "COMPLETION_CALL",
          "invoke_scopes": [
            {
              "actions": [
                "read"
              ],
              "resource_kind": "records.records"
            }
          ],
          "max_attempts": 3,
          "recovery": "RECOVERY_RECOMPUTE",
          "retryable_codes": [
            "503"
          ],
          "tool": {
            "description": "Read the recorded tags of one repository and the recorded pins of one component",
            "effect": "EFFECT_READ_ONLY",
            "name": "Releases_Get_V1_Releases_History"
          },
          "total_timeout": "90s"
        }
      }
    },
