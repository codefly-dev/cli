CREATE TABLE session (
 id TEXT PRIMARY KEY,
 at DATETIME NOT NULL,
 project_snapshot_id TEXT,
 partial_snapshot_id TEXT,
 application_snapshot_id TEXT,
 FOREIGN KEY (project_snapshot_id) REFERENCES project_snapshot(id),
 FOREIGN KEY (partial_snapshot_id) REFERENCES partial_snapshot(id),
 FOREIGN KEY (application_snapshot_id) REFERENCES application_snapshot(id)
);
