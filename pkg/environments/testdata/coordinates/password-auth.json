{
  "schema": "codefly/coordinate/v1",
  "coordinate": "test/region",
  "environment": {
    "name": "staging",
    "namespace": "product",
    "cluster": {"kind": "external", "context": "shared-test"},
    "registry": {"url": "registry.example/team", "auth": "docker"},
    "dns": {"app-host-suffix": "staging.example"},
    "managed-services": {
      "accounts": {
        "kind": "external",
        "external-name": "accounts.example",
        "port": 8443,
        "egress-cidrs": ["192.0.2.0/24"],
        "secret-references": [{
          "name": "accounts-credentials",
          "remote-key": "owners/accounts/staging",
          "property": "credentials",
          "secret-store": {"name": "team-secrets", "kind": "ClusterSecretStore"}
        }]
      },
      "events": {
        "kind": "external",
        "external-name": "events.example",
        "port": 9443
      }
    },
    "service-secrets": {
      "secret-store": {"name": "app-secrets", "kind": "SecretStore"},
      "services": {
        "api": {"remote-keys": {"API_KEY": {"key": "team/api", "property": "token"}}}
      }
    },
    "gitops": {
      "repo-url": "https://example.com/owner/delivery.git",
      "branch": "release",
      "path": "reviewed/product",
      "revision": "approved-commit",
      "inventory": "product.yaml"
    }
  }
}
